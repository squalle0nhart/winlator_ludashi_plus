#version 450

// Corrected fp32 motion search adapted from WinNative PR #537 after e0c4d2c1.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D prevFrame;
layout(set = 0, binding = 1) uniform sampler2D currFrame;
layout(set = 0, binding = 2) uniform sampler2D unusedCoarseFlow;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D motionField;

layout(push_constant) uniform PC {
    ivec2 mvSize;
    vec2 invMvSize;
    float mvScale;
    float minStep;
    float upscale;
    float _pad2;
} pc;

const int LS = 8;
const int BR = 2;
const int RMAX = 15;
const int OFF = 2 * BR + 1;
const float WC = 3.0;
const int TILE_P = LS + 2 * (RMAX + BR);
const int TILE_C = LS + 2 * BR;

shared vec2 sPrev[TILE_P * TILE_P];
shared vec2 sCurr[TILE_C * TILE_C];

float luma(vec3 c) {
    return sqrt(max(dot(c, vec3(0.299, 0.587, 0.114)), 0.0));
}

vec2 descriptorAt(sampler2D image, vec2 uv) {
    vec2 texel = pc.invMvSize;
    vec2 quarter = 0.25 * texel;
    float center = 0.25 * (
        luma(textureLod(image, uv + vec2(-quarter.x, -quarter.y), 0.0).rgb) +
        luma(textureLod(image, uv + vec2( quarter.x, -quarter.y), 0.0).rgb) +
        luma(textureLod(image, uv + vec2(-quarter.x,  quarter.y), 0.0).rgb) +
        luma(textureLod(image, uv + vec2( quarter.x,  quarter.y), 0.0).rgb));
    float mean = 0.25 * (
        luma(textureLod(image, uv + vec2(texel.x, 0.0), 0.0).rgb) +
        luma(textureLod(image, uv - vec2(texel.x, 0.0), 0.0).rgb) +
        luma(textureLod(image, uv + vec2(0.0, texel.y), 0.0).rgb) +
        luma(textureLod(image, uv - vec2(0.0, texel.y), 0.0).rgb));
    return vec2(center, center - mean);
}

float blockCost(ivec2 localPos, ivec2 currentCenter, ivec2 displacement) {
    float cost = 0.0;
    for (int by = -BR; by <= BR; ++by) {
        for (int bx = -BR; bx <= BR; ++bx) {
            ivec2 cc = currentCenter + ivec2(bx, by);
            ivec2 pp = localPos + ivec2(RMAX + BR) + displacement + ivec2(bx, by);
            vec2 delta = sCurr[cc.y * TILE_C + cc.x] - sPrev[pp.y * TILE_P + pp.x];
            cost += delta.x * delta.x + WC * delta.y * delta.y;
        }
    }
    return cost;
}

void main() {
    ivec2 workOrigin = ivec2(gl_WorkGroupID.xy) * LS;
    ivec2 prevOrigin = workOrigin - ivec2(RMAX + BR);
    ivec2 currOrigin = workOrigin - ivec2(BR);
    uint localIndex = gl_LocalInvocationIndex;
    const uint THREADS = uint(LS * LS);

    for (uint i = localIndex; i < uint(TILE_P * TILE_P); i += THREADS) {
        int x = int(i) % TILE_P;
        int y = int(i) / TILE_P;
        vec2 uv = (vec2(prevOrigin + ivec2(x, y)) + 0.5) * pc.invMvSize;
        sPrev[i] = descriptorAt(prevFrame, uv);
    }
    for (uint i = localIndex; i < uint(TILE_C * TILE_C); i += THREADS) {
        int x = int(i) % TILE_C;
        int y = int(i) / TILE_C;
        vec2 uv = (vec2(currOrigin + ivec2(x, y)) + 0.5) * pc.invMvSize;
        sCurr[i] = descriptorAt(currFrame, uv);
    }
    barrier();

    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.mvSize.x || p.y >= pc.mvSize.y) return;

    ivec2 localPos = ivec2(gl_LocalInvocationID.xy);
    ivec2 currentCenter = localPos + ivec2(BR);
    ivec2 center = ivec2(0);
    float bestCost = blockCost(localPos, currentCenter, center);
    int coarseIterations = clamp(6 - int(pc.minStep), 3, 5);

    for (int step = 2; step >= 1; step >>= 1) {
        int iterations = step == 2 ? coarseIterations : 2;
        for (int iteration = 0; iteration < iterations; ++iteration) {
            ivec2 localBestDisplacement = center;
            float localBestCost = bestCost;
            for (int sy = -1; sy <= 1; ++sy) {
                for (int sx = -1; sx <= 1; ++sx) {
                    if (sx == 0 && sy == 0) continue;
                    ivec2 displacement = center + ivec2(sx, sy) * step;
                    if (abs(displacement.x) > RMAX || abs(displacement.y) > RMAX) continue;
                    float candidateCost = blockCost(localPos, currentCenter, displacement);
                    if (candidateCost < localBestCost) {
                        localBestCost = candidateCost;
                        localBestDisplacement = displacement;
                    }
                }
            }
            if (localBestCost >= bestCost * 0.94) break;
            bestCost = localBestCost;
            center = localBestDisplacement;
        }
    }

    ivec2 best = clamp(center, ivec2(-(RMAX - 1)), ivec2(RMAX - 1));
    float c00 = blockCost(localPos, currentCenter, best);
    float cxm = blockCost(localPos, currentCenter, best + ivec2(-1, 0));
    float cxp = blockCost(localPos, currentCenter, best + ivec2( 1, 0));
    float cym = blockCost(localPos, currentCenter, best + ivec2(0, -1));
    float cyp = blockCost(localPos, currentCenter, best + ivec2(0,  1));
    float dx2 = cxm - 2.0 * c00 + cxp;
    float dy2 = cym - 2.0 * c00 + cyp;
    vec2 fraction = vec2(
        dx2 > 1e-7 ? clamp(0.5 * (cxm - cxp) / dx2, -0.5, 0.5) : 0.0,
        dy2 > 1e-7 ? clamp(0.5 * (cym - cyp) / dy2, -0.5, 0.5) : 0.0);
    vec2 subpixel = vec2(best) + fraction;

    float currentLuma = sCurr[currentCenter.y * TILE_C + currentCenter.x].x;
    float previousLuma = luma(textureLod(prevFrame, (vec2(p) + 0.5) * pc.invMvSize, 0.0).rgb);
    float gradientX = abs(sCurr[currentCenter.y * TILE_C + currentCenter.x + 1].x - currentLuma);
    float gradientY = abs(sCurr[(currentCenter.y + 1) * TILE_C + currentCenter.x].x - currentLuma);
    float staticMask = (1.0 - smoothstep(0.012, 0.025, abs(currentLuma - previousLuma)))
                     * smoothstep(0.05, 0.12, gradientX + gradientY);

    float second = 3.0e30;
    if (best.x + OFF <= RMAX) second = min(second, blockCost(localPos, currentCenter, best + ivec2( OFF, 0)));
    if (best.x - OFF >= -RMAX) second = min(second, blockCost(localPos, currentCenter, best + ivec2(-OFF, 0)));
    if (best.y + OFF <= RMAX) second = min(second, blockCost(localPos, currentCenter, best + ivec2(0,  OFF)));
    if (best.y - OFF >= -RMAX) second = min(second, blockCost(localPos, currentCenter, best + ivec2(0, -OFF)));
    float confidence = clamp((second - c00) / (second + 1.0e-3), 0.0, 1.0);

    imageStore(motionField, p, vec4(subpixel * pc.mvScale, staticMask, confidence));
}
