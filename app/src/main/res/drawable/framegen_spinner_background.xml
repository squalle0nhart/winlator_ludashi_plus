<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfacePressed" />
            <stroke android:width="2dp" android:color="?attr/colorAccent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfacePressed" />
            <stroke android:width="2dp" android:color="?attr/colorAccent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceElevated" />
            <stroke android:width="2dp" android:color="?attr/colorOutline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
