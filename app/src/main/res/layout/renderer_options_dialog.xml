<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/SVContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Renderer"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:paddingBottom="8dp"/>
            <Spinner
                android:id="@+id/SPRendererType"
                style="@style/ComboBoxCompact"
                android:background="@drawable/combo_box_no_arrow_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/renderer_present_mode"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <ImageView
                    android:id="@+id/BTHelpRendererPresentMode"
                    style="@style/HelpButton" />
            </LinearLayout>
            <Spinner
                android:id="@+id/SPRendererPresentMode"
                style="@style/ComboBoxCompact"
                android:background="@drawable/combo_box_no_arrow_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/TVRendererPresentModeNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/renderer_present_mode_fg_note"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/GroupDriver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Renderer Driver"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:paddingBottom="8dp"/>
                <Spinner
                    android:id="@+id/SPRendererDriver"
                    style="@style/ComboBoxCompact"
                    android:background="@drawable/combo_box_no_arrow_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/GroupFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Texture Filter"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:paddingBottom="8dp"/>
                <Spinner
                    android:id="@+id/SPRendererFilter"
                    style="@style/ComboBoxCompact"
                    android:background="@drawable/combo_box_no_arrow_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/CBRendererNative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enable Native Rendering+ (Low-Latency Mode)" />

            <CheckBox
                android:id="@+id/CBRendererSwapRB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Swap red/blue channels" />

            <CheckBox
                android:id="@+id/CBRendererSfCompatMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/renderer_sf_compat" />

            <CheckBox
                android:id="@+id/CBRendererLegacyScanout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use legacy 3.0 scanout behavior" />

            <LinearLayout
                android:id="@+id/GroupDisplayX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="DisplayX"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="Surface format" />

                <Spinner
                    android:id="@+id/SPDisplayXSurfaceFormat"
                    style="@style/ComboBoxCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/combo_box_no_arrow_dark"
                    android:spinnerMode="dropdown" />

                <CheckBox
                    android:id="@+id/CBDisplayXTrue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bypass X11 protocol (True DisplayX)" />

                <CheckBox
                    android:id="@+id/CBDisplayXPerformanceMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable DisplayX performance mode" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/GroupGraphicsDefaults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <View
                    style="@style/FieldSeparator"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Graphics Defaults"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:paddingBottom="8dp"/>

                <CheckBox
                    android:id="@+id/CBDefaultUpscaler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable upscaler before launch" />

                <CheckBox
                    android:id="@+id/CBDefaultSupersampling"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Supersampling before launch" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upscaler"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
                <Spinner
                    android:id="@+id/SPDefaultUpscalerMode"
                    style="@style/ComboBoxCompact"
                    android:background="@drawable/combo_box_no_arrow_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post-processing"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
                <Spinner
                    android:id="@+id/SPDefaultPostFXMode"
                    style="@style/ComboBoxCompact"
                    android:background="@drawable/combo_box_no_arrow_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sharpness" />

                    <TextView
                        android:id="@+id/TVDefaultSharpnessValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50" />
                </LinearLayout>

                <com.winlator.cmod.widget.SeekBar
                    android:id="@+id/SBDefaultSharpness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/GroupLsfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <View
                    style="@style/FieldSeparator"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frame Generation"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Backend"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:paddingBottom="8dp"/>

                <Spinner
                    android:id="@+id/SPFrameGenBackend"
                    style="@style/ComboBoxCompact"
                    android:background="@drawable/combo_box_no_arrow_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"/>

                <TextView
                    android:id="@+id/TVLsfgStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frame Multiplier"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:paddingBottom="8dp"/>

                <Spinner
                    android:id="@+id/SPLsfgMultiplier"
                    style="@style/ComboBoxCompact"
                    android:background="@drawable/combo_box_no_arrow_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Flow Scale" />

                    <TextView
                        android:id="@+id/TVLsfgFlowScale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/SBLsfgFlowScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/GroupBionicFgModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Model"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:paddingBottom="8dp"/>

                    <Spinner
                        android:id="@+id/SPBionicFgModel"
                        style="@style/ComboBoxCompact"
                        android:background="@drawable/combo_box_no_arrow_dark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown"/>
                </LinearLayout>

                <CheckBox
                    android:id="@+id/CBLsfgPerformanceMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Performance Mode" />

                <TextView
                    android:id="@+id/TVFrameGenExperimentalWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/frame_generation_experimental_warning"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
